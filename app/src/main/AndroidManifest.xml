<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.abir.assistant">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Abir AI Assistant"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".mlbb.HeroPickerActivity" />
        <activity android:name=".study.StudyModeActivity" />
        <activity android:name=".titles.TitlesActivity" />
        <activity android:name=".titles.AvatarBoardActivity" />
        <activity android:name=".chat.ChatActivity" />
        <activity android:name=".privacy.PrivacyActivity" />
        <activity android:name=".overlay.BubbleSettingsActivity" />
        <activity android:name=".settings.ThemeActivity" />
        <activity android:name=".settings.VoiceSettingsActivity" />
        <activity android:name=".screen.ScreenCaptureActivity" />
        <activity android:name=".social.RankingsActivity" />
        <activity android:name=".core.ErrorActivity" />

        <service
            android:name=".overlay.OverlayService"
            android:exported="false" />
    </application>
</manifest>
